# =============================================================================
# NaijaVerse — environment variables
# Copy this file to `.env` and fill in what you need.
# The game runs locally WITHOUT Supabase (a local fallback keeps profiles
# and characters in the browser). Supabase is only required for online accounts
# and cross-device persistence.
# =============================================================================

# ---------- Game server (Colyseus) ----------
GAME_SERVER_PORT=2567
# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------- Web client (Vite) ----------
# Must be prefixed with VITE_ to be exposed to the browser.
VITE_GAME_SERVER_URL=ws://localhost:2567

# ---------- API service ----------
API_PORT=4000

# ---------- Supabase (optional for Milestone 01) ----------
# Project settings -> API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Same values, exposed to the browser build (safe: anon key is public).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
